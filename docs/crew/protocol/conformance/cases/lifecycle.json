          "expect": {}
        },
        {
          "op": "transition",
          "to": "needs_person",
          "expect": {}
        },
        {
          "op": "transition",
          "to": "running",
          "expect": {
            "task_state": "running"
          }
        }
      ]
    },
    {
      "id": "life-unknown-state",
      "title": "A state that does not exist is refused",
