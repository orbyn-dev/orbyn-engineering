    },
    {
      "id": "life-different-failures-retry",
      "title": "A different failure each time keeps retrying",
      "rules": [
        "H13"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.start",
          "caller": {
            "$use": "lead"
          },
          "args": {
            "$use": "start"
          },
          "expect": {}
        },
        {
          "op": "transition",
          "to": "routed",
          "expect": {}
        },
        {
          "op": "transition",
          "to": "running",
          "expect": {}
        },
        {
          "op": "transition",
          "to": "verifying",
          "expect": {}
        },
        {
          "op": "verify_failed",
          "fingerprint": "a",
          "expect": {
            "result_has": {
              "next": "running"
            }
          }
        },
        {
          "op": "transition",
          "to": "running",
          "expect": {}
        },
        {
          "op": "transition",
          "to": "verifying",
          "expect": {}
        },
        {
          "op": "verify_failed",
          "fingerprint": "b",
          "expect": {
            "result_has": {
              "next": "running"
            }
          }
        },
        {
          "op": "transition",
          "to": "running",
          "expect": {}
        },
        {
          "op": "transition",
          "to": "verifying",
          "expect": {}
        },
        {
          "op": "verify_failed",
          "fingerprint": "c",
          "expect": {
            "result_has": {
              "next": "running"
            }
          }
        }
      ]
    },
    {
      "id": "life-same-failure-twice-changes-approach",
      "title": "The same failure twice means one change of approach, then the run stops",
      "rules": [
        "H13"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.start",
          "caller": {
            "$use": "lead"
          },
