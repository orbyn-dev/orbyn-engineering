        },
        {
          "op": "transition",
          "to": "running",
          "expect": {}
        },
        {
          "op": "transition",
          "to": "verifying",
          "expect": {}
        },
        {
          "op": "verify_failed",
          "fingerprint": "a",
          "expect": {
            "result_has": {
              "next": "running"
            }
          }
        },
        {
          "op": "transition",
          "to": "running",
          "expect": {}
        },
        {
          "op": "transition",
          "to": "verifying",
          "expect": {}
        },
        {
          "op": "verify_failed",
          "fingerprint": "a",
          "expect": {
            "result_has": {
              "next": "changed_approach"
            }
          }
        },
        {
          "op": "transition",
          "to": "changed_approach",
          "expect": {}
        },
        {
          "op": "transition",
          "to": "running",
          "expect": {}
        },
        {
          "op": "transition",
          "to": "verifying",
          "expect": {}
        },
        {
          "op": "verify_failed",
          "fingerprint": "a",
          "expect": {
            "result_has": {
              "next": "stopped"
            }
          }
        },
        {
          "op": "transition",
          "to": "stopped",
          "expect": {
            "run_ended": true
          }
        }
      ]
    },
    {
