          "expect": {}
        },
        {
          "op": "transition",
          "to": "failed",
          "expect": {
            "error": "invalid_transition"
          }
        }
      ]
    },
    {
      "id": "life-verify-failed-needs-verifying",
      "title": "A failed verification needs a task that is verifying",
      "rules": [
        "H13"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.start",
