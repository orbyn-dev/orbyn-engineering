{
  "suite": "The task lifecycle and the loop guard",
  "cases": [
    {
      "id": "life-happy-path",
      "title": "Briefed, routed, running, verifying, passed",
      "rules": [
        "H13"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.start",
          "caller": {
            "$use": "lead"
          },
          "args": {
            "$use": "start"
          },
          "expect": {}
        },
        {
          "op": "transition",
          "to": "routed",
          "expect": {}
        },
        {
          "op": "transition",
          "to": "running",
          "expect": {}
        },
        {
          "op": "transition",
          "to": "verifying",
          "expect": {
            "task_state": "verifying"
          }
        },
        {
          "op": "transition",
          "to": "passed",
          "evidence": 2,
          "expect": {
            "task_state": "passed",
            "run_ended": true
          }
        }
      ]
    },
    {
      "id": "life-must-be-routed",
      "title": "A task cannot run before it is routed",
      "rules": [
        "H13"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.start",
          "caller": {
            "$use": "lead"
          },
          "args": {
            "$use": "start"
          },
          "expect": {}
        },
        {
          "op": "transition",
          "to": "running",
          "expect": {
            "error": "invalid_transition"
          }
        }
      ]
    },
    {
      "id": "life-passed-needs-evidence",
      "title": "A task cannot pass without evidence or a person",
      "rules": [
        "H8",
        "H13"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.start",
          "caller": {
            "$use": "lead"
          },
          "args": {
            "$use": "start"
          },
          "expect": {}
        },
        {
          "op": "transition",
          "to": "routed",
          "expect": {}
        },
        {
          "op": "transition",
          "to": "running",
          "expect": {}
        },
        {
          "op": "transition",
          "to": "verifying",
          "expect": {}
        },
        {
          "op": "transition",
          "to": "passed",
          "expect": {
            "error": "gate_needs_evidence"
          }
        },
        {
          "op": "transition",
          "to": "passed",
          "person": true,
          "expect": {
            "task_state": "passed"
          }
        }
      ]
    },
    {
      "id": "life-terminal-is-final",
      "title": "A passed task cannot move again",
      "rules": [
        "H13"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.start",
          "caller": {
            "$use": "lead"
          },
          "args": {
            "$use": "start"
          },
          "expect": {}
        },
        {
          "op": "transition",
          "to": "routed",
          "expect": {}
        },
        {
          "op": "transition",
          "to": "running",
          "expect": {}
        },
        {
          "op": "transition",
          "to": "verifying",
          "expect": {}
        },
        {
          "op": "transition",
          "to": "passed",
          "evidence": 1,
          "expect": {}
        },
        {
          "op": "transition",
          "to": "running",
          "expect": {
            "error": "invalid_transition"
          }
        }
      ]
    },
    {
      "id": "life-cancelled-is-final",
      "title": "A cancelled task cannot be revived",
      "rules": [
        "H13"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.start",
          "caller": {
            "$use": "lead"
          },
          "args": {
            "$use": "start"
          },
          "expect": {}
        },
        {
          "op": "transition",
          "to": "cancelled",
          "expect": {}
        },
        {
          "op": "transition",
          "to": "routed",
          "expect": {
            "error": "invalid_transition"
          }
        }
      ]
    },
    {
      "id": "life-failed-only-by-verifier",
      "title": "A task enters failed only through a failed verification",
