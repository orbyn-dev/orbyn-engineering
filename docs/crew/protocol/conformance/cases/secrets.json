{
  "suite": "No secrets in any object",
  "cases": [
    {
      "id": "secret-github_token",
      "title": "A github token in a message body is refused",
      "rules": [
        "H2"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.post",
          "caller": {
            "$use": "worker1"
          },
          "args": {
            "to": "lead",
            "kind": "fact",
            "body": "Use {{fake:github_token}} now."
          },
          "expect": {
            "error": "secret_detected"
          }
        }
      ]
    },
    {
      "id": "secret-aws_key",
      "title": "A aws key in a message body is refused",
      "rules": [
        "H2"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.post",
          "caller": {
            "$use": "worker1"
          },
          "args": {
            "to": "lead",
            "kind": "fact",
            "body": "Use {{fake:aws_key}} now."
          },
          "expect": {
            "error": "secret_detected"
          }
        }
      ]
    },
    {
      "id": "secret-private_key",
      "title": "A private key in a message body is refused",
      "rules": [
        "H2"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.post",
          "caller": {
            "$use": "worker1"
          },
          "args": {
            "to": "lead",
            "kind": "fact",
            "body": "Use {{fake:private_key}} now."
          },
          "expect": {
            "error": "secret_detected"
          }
        }
      ]
    },
    {
      "id": "secret-bearer",
      "title": "A bearer in a message body is refused",
      "rules": [
        "H2"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.post",
          "caller": {
            "$use": "worker1"
          },
          "args": {
            "to": "lead",
            "kind": "fact",
            "body": "Use {{fake:bearer}} now."
          },
          "expect": {
            "error": "secret_detected"
          }
        }
      ]
    },
    {
      "id": "secret-assignment",
      "title": "A assignment in a message body is refused",
      "rules": [
        "H2"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.post",
          "caller": {
            "$use": "worker1"
          },
          "args": {
            "to": "lead",
            "kind": "fact",
            "body": "Use {{fake:assignment}} now."
          },
          "expect": {
            "error": "secret_detected"
          }
        }
      ]
    },
    {
      "id": "secret-nested-fact",
      "title": "A secret nested inside a fact value is refused",
      "rules": [
        "H2"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.fact.write",
          "caller": {
            "$use": "worker1"
          },
          "args": {
            "key": "demo.config",
            "class": "observation",
            "value": {
              "deep": [
                "{{fake:github_token}}"
              ]
            },
            "base_rev": 0,
            "evidence": []
          },
          "expect": {
            "error": "secret_detected"
          }
        }
      ]
    },
    {
      "id": "secret-json-field",
      "title": "A field named like a credential with a long value is refused",
      "rules": [
        "H2"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.fact.write",
          "caller": {
            "$use": "worker1"
          },
          "args": {
            "key": "demo.config",
            "class": "observation",
            "value": {
              "password": "hunter2hunter2"
            },
            "base_rev": 0,
            "evidence": []
          },
          "expect": {
            "error": "secret_detected"
          }
        }
      ]
    },
    {
      "id": "secret-in-full-object",
      "title": "A secret in a stamped object is refused before its id is checked",
      "rules": [
        "H2"
      ],
      "steps": [
        {
          "op": "validate",
          "object": {
            "$example": "report.valid.basic",
            "mutate": {
              "summary": "Token {{fake:github_token}}"
            }
          },
          "expect": {
            "error": "secret_detected"
          }
        }
      ]
    },
    {
      "id": "secret-lookalike-ok",
      "title": "Ordinary words that mention passwords are not refused",
      "rules": [
        "H2"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.post",
          "caller": {
            "$use": "worker1"
          },
          "args": {
            "to": "lead",
            "kind": "fact",
            "body": "The password field is validated before it is stored."
          },
          "expect": {}
        }
      ]
    }
  ]
}
