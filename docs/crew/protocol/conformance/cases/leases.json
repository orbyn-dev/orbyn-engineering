          },
          "args": {
            "$use": "start-wide"
          },
          "expect": {}
        },
        {
          "op": "call",
          "tool": "crew.lease.request",
          "caller": {
            "$use": "worker1"
          },
          "args": {
            "paths": [
              "crates/crew-demo/src/**"
