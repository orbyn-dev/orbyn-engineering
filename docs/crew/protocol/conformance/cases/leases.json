          "caller": {
            "$use": "worker1"
          },
          "args": {
            "paths": [
              "docs/**"
            ]
          },
          "expect": {}
        },
        {
          "op": "call",
          "tool": "crew.lease.request",
          "caller": {
            "$use": "worker2"
          },
          "args": {
            "paths": [
              "docs/**"
            ],
            "mode": "write",
            "expires_at": "2026-11-12T10:00:00Z"
          },
          "expect": {}
