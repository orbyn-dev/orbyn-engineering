            "mode": "write",
            "expires_at": "2026-11-12T10:00:00Z"
          },
          "expect": {}
        },
        {
          "op": "call",
          "tool": "crew.lease.request",
          "caller": {
            "$use": "worker2"
          },
          "args": {
            "paths": [
              "crates/crew-demo/**"
            ],
            "mode": "write",
            "expires_at": "2026-11-12T10:00:00Z"
          },
          "expect": {}
        }
      ]
    },
    {
      "id": "lease-read-read-ok",
      "title": "Two readers share a path",
      "rules": [
        "H10"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.lease.request",
          "caller": {
            "$use": "worker1"
          },
          "args": {
            "paths": [
              "docs/**"
