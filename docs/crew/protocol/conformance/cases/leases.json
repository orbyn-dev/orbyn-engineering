            "expires_at": "2026-11-12T10:00:00Z"
          },
          "expect": {}
        },
        {
          "op": "call",
          "tool": "crew.lease.request",
          "caller": {
            "$use": "worker2"
          },
          "args": {
            "paths": [
              "docs/**"
            ],
            "mode": "read",
            "expires_at": "2026-11-12T10:00:00Z"
          },
          "expect": {}
        }
      ]
    },
    {
      "id": "lease-read-write-conflict",
      "title": "A writer cannot take a path another member reads",
      "rules": [
        "H10"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.lease.request",
          "caller": {
            "$use": "worker1"
          },
          "args": {
            "paths": [
              "docs/**"
            ],
            "mode": "read",
            "expires_at": "2026-11-12T10:00:00Z"
          },
          "expect": {}
        },
        {
          "op": "call",
          "tool": "crew.lease.request",
          "caller": {
            "$use": "worker2"
          },
          "args": {
            "paths": [
              "docs/guide.md"
            ],
            "mode": "write",
            "expires_at": "2026-11-12T10:00:00Z"
          },
          "expect": {
            "error": "lease_conflict"
          }
        }
      ]
    },
    {
      "id": "lease-same-holder-ok",
      "title": "A member can request overlapping paths again",
      "rules": [
        "H10"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.lease.request",
          "caller": {
            "$use": "worker1"
          },
          "args": {
            "paths": [
              "docs/**"
            ],
            "mode": "write",
            "expires_at": "2026-11-12T10:00:00Z"
          },
          "expect": {}
        },
        {
          "op": "call",
          "tool": "crew.lease.request",
          "caller": {
            "$use": "worker1"
          },
          "args": {
            "paths": [
              "docs/guide.md"
            ],
            "mode": "write",
            "expires_at": "2026-11-12T10:00:00Z"
          },
          "expect": {}
        }
      ]
    },
    {
      "id": "lease-release-then-take",
      "title": "A released path can be taken",
      "rules": [
        "H10"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.lease.request",
          "caller": {
            "$use": "worker1"
          },
          "args": {
            "paths": [
              "docs/**"
            ],
            "mode": "write",
            "expires_at": "2026-11-12T10:00:00Z"
          },
          "expect": {}
        },
        {
          "op": "call",
