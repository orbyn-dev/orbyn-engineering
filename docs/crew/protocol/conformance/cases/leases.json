    },
    {
      "id": "lease-release-not-held",
      "title": "Releasing a lease that is not held is refused",
      "rules": [
        "H10"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.lease.release",
          "caller": {
            "$use": "worker1"
          },
          "args": {
            "paths": [
              "docs/**"
            ]
          },
          "expect": {
            "error": "lease_not_held"
          }
        }
      ]
    },
    {
      "id": "lease-escaping-path",
      "title": "A path that leaves the worktree is refused",
      "rules": [
        "H10"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.lease.request",
          "caller": {
            "$use": "worker1"
          },
          "args": {
            "paths": [
              "../outside/**"
            ],
            "mode": "write",
            "expires_at": "2026-11-12T10:00:00Z"
          },
          "expect": {
            "error": "invalid_object"
          }
        }
      ]
    },
    {
      "id": "lease-forged-holder",
      "title": "A member cannot name the holder or the state itself",
      "rules": [
        "H9"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.lease.request",
          "caller": {
            "$use": "worker1"
          },
          "args": {
            "paths": [
              "docs/**"
            ],
            "mode": "write",
            "expires_at": "2026-11-12T10:00:00Z",
            "holder": "worker-02",
            "state": "granted"
          },
          "expect": {
            "error": "invalid_object"
          }
        }
      ]
    }
