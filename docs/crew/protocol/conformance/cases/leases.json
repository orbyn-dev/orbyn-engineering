{
  "suite": "Leases: one writer per path",
  "cases": [
    {
      "id": "lease-grant",
      "title": "A free path is granted",
      "rules": [
        "H10"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.lease.request",
          "caller": {
            "$use": "worker1"
          },
          "args": {
            "paths": [
              "crates/crew-demo/src/**"
            ],
            "mode": "write",
            "expires_at": "2026-11-12T10:00:00Z"
          },
          "expect": {
            "result_has": {
              "state": "granted"
            }
          }
        }
      ]
    },
    {
      "id": "lease-write-write-conflict",
      "title": "Two writers cannot hold overlapping paths; the lead is told",
      "rules": [
        "H10"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.lease.request",
          "caller": {
            "$use": "worker1"
          },
          "args": {
            "paths": [
              "crates/crew-demo/src/**"
            ],
            "mode": "write",
            "expires_at": "2026-11-12T10:00:00Z"
          },
          "expect": {}
        },
        {
          "op": "call",
          "tool": "crew.lease.request",
          "caller": {
            "$use": "worker2"
          },
          "args": {
            "paths": [
              "crates/crew-demo/src/lib.rs"
            ],
            "mode": "write",
            "expires_at": "2026-11-12T10:00:00Z"
          },
          "expect": {
            "error": "lease_conflict",
            "lead_notified": true
          }
        }
      ]
    },
    {
      "id": "lease-tree-and-tree",
      "title": "A tree overlaps a tree inside it",
      "rules": [
        "H10"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.lease.request",
          "caller": {
            "$use": "worker1"
          },
          "args": {
            "paths": [
              "crates/**"
            ],
            "mode": "write",
            "expires_at": "2026-11-12T10:00:00Z"
          },
          "expect": {}
        },
        {
          "op": "call",
          "tool": "crew.lease.request",
          "caller": {
            "$use": "worker2"
          },
          "args": {
            "paths": [
              "crates/crew-demo/src/**"
            ],
            "mode": "write",
            "expires_at": "2026-11-12T10:00:00Z"
          },
          "expect": {
            "error": "lease_conflict"
          }
        }
      ]
    },
    {
      "id": "lease-same-file",
      "title": "The same file conflicts",
      "rules": [
        "H10"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.lease.request",
          "caller": {
            "$use": "worker1"
          },
          "args": {
            "paths": [
              "docs/guide.md"
            ],
            "mode": "write",
            "expires_at": "2026-11-12T10:00:00Z"
          },
          "expect": {}
        },
        {
          "op": "call",
          "tool": "crew.lease.request",
          "caller": {
            "$use": "worker2"
          },
          "args": {
            "paths": [
              "docs/guide.md"
            ],
            "mode": "write",
            "expires_at": "2026-11-12T10:00:00Z"
          },
          "expect": {
            "error": "lease_conflict"
          }
        }
      ]
    },
    {
      "id": "lease-disjoint-ok",
      "title": "Disjoint paths are both granted",
      "rules": [
        "H10"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.lease.request",
          "caller": {
            "$use": "worker1"
          },
          "args": {
            "paths": [
              "crates/a/**"
            ],
            "mode": "write",
            "expires_at": "2026-11-12T10:00:00Z"
          },
          "expect": {}
        },
        {
          "op": "call",
          "tool": "crew.lease.request",
          "caller": {
            "$use": "worker2"
          },
          "args": {
            "paths": [
              "crates/b/**"
            ],
            "mode": "write",
            "expires_at": "2026-11-12T10:00:00Z"
          },
          "expect": {}
        },
        {
          "op": "call",
          "tool": "crew.lease.request",
          "caller": {
            "$use": "worker3"
          },
          "args": {
            "paths": [
              "docs/guide.md"
            ],
            "mode": "write",
            "expires_at": "2026-11-12T10:00:00Z"
          },
          "expect": {}
        }
      ]
    },
    {
      "id": "lease-sibling-prefix-not-overlap",
      "title": "A directory whose name only starts the same does not overlap",
      "rules": [
        "H10"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.lease.request",
          "caller": {
            "$use": "worker1"
          },
          "args": {
            "paths": [
              "crates/crew/**"
