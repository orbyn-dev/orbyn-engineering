{
  "suite": "The answer key never reaches a worker",
  "cases": [
    {
      "id": "key-brief-read-ok",
      "title": "A worker reads its brief and nothing of the key travels with it",
      "rules": [
        "H1"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.start",
          "caller": {
            "$use": "lead"
          },
          "args": {
            "$use": "start"
          },
          "expect": {}
        },
        {
          "op": "call",
          "tool": "crew.brief.read",
          "caller": {
            "$use": "worker1"
          },
          "args": {},
          "expect": {
            "result_text": {
              "absent": [
                "chk-tests",
                "cargo test -p crew-demo",
                "protected_paths",
                "scripts/check.sh"
              ]
            }
          }
        }
      ]
    },
    {
      "id": "key-command-leaked-in-brief",
      "title": "A brief that repeats a key command is not delivered",
      "rules": [
        "H1"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.start",
          "caller": {
            "$use": "lead"
          },
          "args": {
            "$use": "start",
            "set": {
              "brief": {
                "kind": "implement",
                "outcome": "Make `cargo test -p crew-demo` pass.",
                "inputs": [],
                "files": [
                  {
                    "path": "crates/crew-demo/src/**",
                    "mode": "write"
                  }
                ],
                "allowed_effects": [
                  "read_repo",
                  "write_leased"
                ],
                "stop_when": [
                  "Done."
                ],
                "budget": {
                  "turns": 5,
                  "minutes": 10
                }
              }
            }
          },
          "expect": {}
        },
        {
          "op": "call",
          "tool": "crew.brief.read",
          "caller": {
            "$use": "worker1"
          },
          "args": {},
          "expect": {
            "error": "answer_key_forbidden"
          }
        }
      ]
    },
    {
      "id": "key-write-lease-on-protected-path",
      "title": "A write lease over a protected path is refused",
      "rules": [
        "H11"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.start",
          "caller": {
            "$use": "lead"
          },
          "args": {
            "$use": "start",
            "set": {
              "brief": {
                "kind": "implement",
                "outcome": "Edit the tests.",
                "inputs": [],
                "files": [
                  {
                    "path": "crates/crew-demo/**",
                    "mode": "write"
                  }
                ],
                "allowed_effects": [
                  "write_leased"
                ],
                "stop_when": [
                  "Done."
                ],
                "budget": {
                  "turns": 5,
                  "minutes": 10
                }
              }
            }
          },
          "expect": {
            "error": "protected_path_conflict"
          }
        }
      ]
    },
    {
      "id": "key-protected-file-exact",
      "title": "A write lease on one protected file is refused",
      "rules": [
        "H11"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.start",
          "caller": {
            "$use": "lead"
          },
          "args": {
            "$use": "start",
            "set": {
              "brief": {
                "kind": "implement",
                "outcome": "Change the check script.",
                "inputs": [],
                "files": [
                  {
                    "path": "scripts/check.sh",
                    "mode": "write"
                  }
                ],
                "allowed_effects": [
                  "write_leased"
                ],
                "stop_when": [
                  "Done."
                ],
                "budget": {
                  "turns": 5,
                  "minutes": 10
                }
              }
            }
          },
          "expect": {
            "error": "protected_path_conflict"
          }
        }
      ]
    },
    {
      "id": "key-read-lease-on-protected-path-ok",
      "title": "A read lease over a protected path is allowed",
      "rules": [
        "H11"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.start",
          "caller": {
            "$use": "lead"
          },
          "args": {
            "$use": "start",
            "set": {
              "brief": {
                "kind": "review",
                "outcome": "Read the tests.",
                "inputs": [],
                "files": [
                  {
                    "path": "crates/crew-demo/tests/**",
                    "mode": "read"
                  }
                ],
                "allowed_effects": [
                  "read_repo"
                ],
                "stop_when": [
                  "Done."
                ],
                "budget": {
                  "turns": 5,
                  "minutes": 10
                }
              }
            }
          },
          "expect": {}
        }
      ]
    }
  ]
}
