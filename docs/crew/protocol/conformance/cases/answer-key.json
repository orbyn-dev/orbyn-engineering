        {
          "op": "call",
          "tool": "crew.post",
          "caller": {
            "$use": "lead"
          },
          "args": {
            "to": "worker-01",
            "kind": "handoff",
            "body": "Make `cargo test -p crew-demo` pass."
          },
          "expect": {
            "error": "answer_key_forbidden"
          }
        }
      ]
    },
