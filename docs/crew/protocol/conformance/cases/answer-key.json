{
  "suite": "The answer key never reaches a worker",
  "cases": [
    {
      "id": "key-brief-read-ok",
      "title": "A worker reads its brief and nothing of the key travels with it",
      "rules": [
        "H1"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.start",
          "caller": {
            "$use": "lead"
          },
          "args": {
            "$use": "start"
          },
          "expect": {}
        },
        {
          "op": "call",
          "tool": "crew.brief.read",
          "caller": {
            "$use": "worker1"
          },
          "args": {},
          "expect": {
            "result_text": {
              "absent": [
                "chk-tests",
                "cargo test -p crew-demo",
                "protected_paths",
                "scripts/check.sh"
              ]
            }
          }
        }
      ]
    },
    {
      "id": "key-command-leaked-in-brief",
      "title": "A brief that repeats a key command is refused at crew.start",
      "rules": [
        "H1"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.start",
          "caller": {
            "$use": "lead"
          },
          "args": {
            "$use": "start",
            "set": {
              "brief": {
                "kind": "implement",
                "outcome": "Make `cargo test -p crew-demo` pass.",
                "inputs": [],
                "files": [
                  {
                    "path": "crates/crew-demo/src/**",
                    "mode": "write"
                  }
                ],
                "allowed_effects": [
                  "read_repo",
                  "write_leased"
                ],
                "stop_when": [
                  "Done."
                ],
                "budget": {
                  "turns": 5,
                  "minutes": 10
                }
              }
            }
          },
          "expect": {
            "error": "answer_key_forbidden"
          }
        }
      ]
    },
    {
      "id": "key-command-leaked-in-input",
      "title": "A key command hidden in an input is refused too",
      "rules": [
        "H1"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.start",
          "caller": {
            "$use": "lead"
          },
          "args": {
            "$use": "start",
            "set": {
              "brief": {
                "kind": "implement",
                "outcome": "Add the function.",
                "inputs": [
                  {
                    "kind": "text",
                    "text": "Run cargo test -p crew-demo until it is green."
                  }
                ],
                "files": [
                  {
                    "path": "crates/crew-demo/src/**",
                    "mode": "write"
                  }
                ],
                "allowed_effects": [
                  "read_repo",
                  "write_leased"
                ],
                "stop_when": [
                  "Done."
                ],
                "budget": {
                  "turns": 5,
                  "minutes": 10
                }
              }
            }
          },
          "expect": {
            "error": "answer_key_forbidden"
          }
        }
      ]
    },
    {
      "id": "key-lead-post-leaks-command",
      "title": "A lead message to a worker that repeats a key command is refused",
