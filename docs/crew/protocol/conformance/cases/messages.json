          "op": "call",
          "tool": "crew.post",
          "caller": {
            "$use": "worker2"
          },
          "args": {
            "to": "worker-01",
            "kind": "fact",
            "body": "Here is a fact."
          },
          "expect": {
            "lead_notified": true,
            "error": "hop_limit_exceeded"
          }
        }
      ]
    },
