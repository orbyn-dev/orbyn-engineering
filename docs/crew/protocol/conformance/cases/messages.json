    {
      "id": "msg-ask-is-a-question",
      "title": "crew.ask sends a question and may wait up to 40 seconds",
      "rules": [
        "H6"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.ask",
          "caller": {
            "$use": "worker1"
          },
          "args": {
            "to": "worker-02",
            "kind": "question",
            "body": "Which error type?",
            "wait_seconds": 40,
            "expects_reply": true
          },
          "expect": {}
        }
      ]
    },
    {
      "id": "msg-ask-wait-too-long",
      "title": "crew.ask cannot wait longer than 40 seconds",
      "rules": [
        "H6"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.ask",
          "caller": {
            "$use": "worker1"
          },
          "args": {
            "to": "worker-02",
            "kind": "question",
            "body": "Which error type?",
            "wait_seconds": 41
          },
          "expect": {
            "error": "invalid_object"
          }
        }
      ]
    },
    {
      "id": "msg-ask-must-be-a-question",
      "title": "crew.ask refuses any other kind",
