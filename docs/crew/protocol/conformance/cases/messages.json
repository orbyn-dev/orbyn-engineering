    {
      "id": "msg-hop-limit",
      "title": "The fourth message between two members is refused and the lead is told",
      "rules": [
        "H4"
      ],
      "steps": [
        {
          "op": "call",
          "tool": "crew.post",
          "caller": {
            "$use": "worker1"
          },
          "args": {
            "to": "worker-02",
            "kind": "fact",
            "body": "Here is a fact."
          },
          "expect": {}
        },
        {
          "op": "call",
          "tool": "crew.post",
          "caller": {
            "$use": "worker2"
          },
          "args": {
            "to": "worker-01",
            "kind": "fact",
            "body": "Here is a fact."
          },
          "expect": {}
