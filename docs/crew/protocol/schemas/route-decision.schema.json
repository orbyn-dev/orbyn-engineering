{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbyn.dev/crew/protocol/v0/route-decision.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0. Crew Protocol v0, unpublished.",
  "title": "RouteDecision",
  "description": "Which engine was chosen for a brief and why, with every rejected engine and its reason. Written only by the core.",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    },
    {
      "if": {
        "required": [
          "assigned_by"
        ],
        "properties": {
          "assigned_by": {
            "enum": [
              "person",
              "lead"
            ]
          }
        }
      },
      "then": {
        "required": [
          "requested"
        ]
      }
    },
    {
      "if": {
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "const": "review"
          }
        }
      },
      "then": {
        "required": [
          "lane"
        ]
      },
      "else": {
        "not": {
          "required": [
            "lane"
          ]
        }
      }
    }
  ],
  "required": [
    "run_id",
    "brief",
    "engine",
    "model",
    "effort",
    "tier",
    "role",
    "assigned_by",
    "reasons",
    "rejected",
    "scores"
  ],
  "unevaluatedProperties": false,
  "properties": {
    "type": {
      "const": "route_decision"
    },
    "author": {
      "properties": {
        "role": {
          "const": "core"
        }
      }
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/opaque_id"
    },
    "brief": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "engine": {
      "$ref": "common.schema.json#/$defs/token"
    },
    "model": {
      "$ref": "common.schema.json#/$defs/text_short"
    },
    "effort": {
      "description": "Never above medium in v0.",
      "enum": [
        "low",
        "medium"
      ]
    },
    "tier": {
      "enum": [
        "lead",
        "worker",
        "scout"
      ]
    },
    "role": {
      "enum": [
        "builder",
        "code_review",
        "security_review",
        "finding_check",
        "second_key",
        "scout",
        "review"
      ]
    },
    "assigned_by": {
      "enum": [
        "router",
        "person",
        "lead"
      ]
    },
    "requested": {
      "description": "What the person or lead asked for. The decision never quietly swaps it.",
      "type": "object",
      "required": [
        "engine"
      ],
      "additionalProperties": false,
      "properties": {
        "engine": {
          "$ref": "common.schema.json#/$defs/token"
        },
        "model": {
          "$ref": "common.schema.json#/$defs/text_short"
        }
      }
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "code",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "common.schema.json#/$defs/token"
          },
          "text": {
            "$ref": "common.schema.json#/$defs/text_short"
          }
        }
      }
    },
    "rejected": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "engine",
          "why",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "engine": {
            "$ref": "common.schema.json#/$defs/token"
          },
          "why": {
            "enum": [
              "not_installed",
              "not_signed_in",
              "compatibility_broken",
              "not_managed",
              "no_approvals",
              "missing_capability",
              "quota_exhausted",
              "tier_below_lead",
              "same_engine_refused"
            ]
          },
          "text": {
            "$ref": "common.schema.json#/$defs/text_short"
          }
        }
      }
    },
    "scores": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "engine",
          "score",
          "used_defaults"
        ],
        "additionalProperties": false,
        "properties": {
          "engine": {
            "$ref": "common.schema.json#/$defs/token"
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "used_defaults": {
            "description": "True when no measured result backed this score.",
            "type": "boolean"
          },
          "pass_rate": {
            "description": "A rate always travels with its sample size.",
            "type": "object",
            "required": [
              "permille",
              "samples"
            ],
            "additionalProperties": false,
            "properties": {
              "permille": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "samples": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "lane": {
      "description": "The reviewer lane when role is review, for example accessibility, performance, design, licence, docs or a custom lane.",
      "$ref": "common.schema.json#/$defs/token"
    }
  }
}
