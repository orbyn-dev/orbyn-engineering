{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbyn.dev/crew/protocol/v0/disagreement.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0. Crew Protocol v0, unpublished.",
  "title": "Disagreement",
  "description": "Two or more members hold opposing positions on one subject. Both positions and their evidence are one item to resolve.",
  "type": "object",
  "allOf": [{ "$ref": "common.schema.json#/$defs/envelope" }],
  "required": ["run_id", "subject", "topic", "positions"],
  "unevaluatedProperties": false,
  "properties": {
    "type": { "const": "disagreement" },
    "run_id": { "$ref": "common.schema.json#/$defs/opaque_id" },
    "subject": { "$ref": "common.schema.json#/$defs/hash" },
    "topic": { "$ref": "common.schema.json#/$defs/text_short" },
    "positions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["member", "engine", "stance", "evidence"],
        "additionalProperties": false,
        "properties": {
          "member": { "$ref": "common.schema.json#/$defs/member_id" },
          "engine": { "$ref": "common.schema.json#/$defs/token" },
          "stance": { "$ref": "common.schema.json#/$defs/text_short" },
          "evidence": { "type": "array", "maxItems": 32, "items": { "$ref": "common.schema.json#/$defs/hash" } }
        }
      }
    }
  }
}
