{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbyn.dev/crew/protocol/v0/check.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0. Crew Protocol v0, unpublished.",
  "title": "Check",
  "description": "One verifiable check. It sits inside an AnswerKey, a contract Fact or a Claim; it is not an object with its own id. Only the core runs it.",
  "type": "object",
  "required": ["id", "kind", "params", "proves"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/opaque_id" },
    "kind": {
      "enum": [
        "command", "test", "lint", "typecheck", "custom_script",
        "file_scope", "diff_size", "schema", "http_probe", "preview",
        "visual_compare", "repo_required", "manual", "screenshot_only",
        "accessibility_audit", "performance_budget", "secret_scan", "licence_scan"
      ]
    },
    "params": { "type": "object" },
    "proves": { "$ref": "common.schema.json#/$defs/text_short" },
    "does_not_prove": { "$ref": "common.schema.json#/$defs/text_short" }
  },
  "allOf": [
    {
      "if": { "required": ["kind"], "properties": { "kind": { "enum": ["command", "test", "lint", "typecheck", "custom_script"] } } },
      "then": { "properties": { "params": { "$ref": "#/$defs/run_params" } } }
    },
    {
      "if": { "required": ["kind"], "properties": { "kind": { "const": "file_scope" } } },
      "then": { "properties": { "params": { "$ref": "#/$defs/file_scope_params" } } }
    },
    {
      "if": { "required": ["kind"], "properties": { "kind": { "const": "diff_size" } } },
      "then": { "properties": { "params": { "$ref": "#/$defs/diff_size_params" } } }
    },
    {
      "if": { "required": ["kind"], "properties": { "kind": { "const": "schema" } } },
      "then": { "properties": { "params": { "$ref": "#/$defs/schema_params" } } }
    },
    {
      "if": { "required": ["kind"], "properties": { "kind": { "const": "http_probe" } } },
      "then": { "properties": { "params": { "$ref": "#/$defs/http_probe_params" } } }
    },
    {
      "if": { "required": ["kind"], "properties": { "kind": { "enum": ["preview", "screenshot_only", "accessibility_audit"] } } },
      "then": { "properties": { "params": { "$ref": "#/$defs/page_params" } } }
    },
    {
      "if": { "required": ["kind"], "properties": { "kind": { "const": "visual_compare" } } },
      "then": { "properties": { "params": { "$ref": "#/$defs/visual_params" } } }
    },
    {
      "if": { "required": ["kind"], "properties": { "kind": { "const": "performance_budget" } } },
      "then": { "properties": { "params": { "$ref": "#/$defs/budget_params" } } }
    },
    {
      "if": { "required": ["kind"], "properties": { "kind": { "enum": ["repo_required", "manual"] } } },
      "then": { "properties": { "params": { "$ref": "#/$defs/named_params" } } }
    },
    {
      "if": { "required": ["kind"], "properties": { "kind": { "enum": ["secret_scan", "licence_scan"] } } },
      "then": { "properties": { "params": { "$ref": "#/$defs/empty_params" } } }
    }
  ],
  "$defs": {
    "empty_params": { "type": "object", "additionalProperties": false },
    "run_params": {
      "description": "The exact command. expect_exit defaults to 0.",
      "type": "object",
      "required": ["run"],
      "additionalProperties": false,
      "properties": {
        "run": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "expect_exit": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "file_scope_params": {
      "description": "Only these paths may have changed.",
      "type": "object",
      "required": ["only"],
      "additionalProperties": false,
      "properties": {
        "only": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "common.schema.json#/$defs/path_pattern" } }
      }
    },
    "diff_size_params": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "max_files": { "type": "integer", "minimum": 0 },
        "max_lines": { "type": "integer", "minimum": 0 }
      }
    },
    "schema_params": {
      "type": "object",
      "required": ["schema", "instance"],
      "additionalProperties": false,
      "properties": {
        "schema": { "$ref": "common.schema.json#/$defs/rel_path" },
        "instance": { "$ref": "common.schema.json#/$defs/rel_path" }
      }
    },
    "http_probe_params": {
      "type": "object",
      "required": ["url", "expect_status"],
      "additionalProperties": false,
      "properties": {
        "url": { "$ref": "common.schema.json#/$defs/loopback_url" },
        "expect_status": { "type": "integer", "minimum": 100, "maximum": 599 }
      }
    },
    "page_params": {
      "description": "A page that must load; preview also requires no console errors.",
      "type": "object",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "url": { "$ref": "common.schema.json#/$defs/loopback_url" },
        "screenshot": { "type": "boolean" }
      }
    },
    "visual_params": {
      "type": "object",
      "required": ["frame", "tolerance_permille"],
      "additionalProperties": false,
      "properties": {
        "frame": { "$ref": "common.schema.json#/$defs/text_short" },
        "tolerance_permille": { "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    },
    "budget_params": {
      "type": "object",
      "required": ["metric", "max"],
      "additionalProperties": false,
      "properties": {
        "metric": { "$ref": "common.schema.json#/$defs/token" },
        "max": { "type": "integer", "minimum": 0 }
      }
    },
    "named_params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/text_short" },
        "note": { "$ref": "common.schema.json#/$defs/text_short" }
      }
    }
  }
}
