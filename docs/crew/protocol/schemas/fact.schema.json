{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbyn.dev/crew/protocol/v0/fact.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0. Crew Protocol v0, unpublished.",
  "title": "Fact",
  "description": "A typed fact on the shared board. A contract fact carries the check every consumer gets.",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    },
    {
      "if": {
        "required": [
          "class"
        ],
        "properties": {
          "class": {
            "const": "contract"
          }
        }
      },
      "then": {
        "required": [
          "check"
        ]
      }
    }
  ],
  "required": [
    "run_id",
    "key",
    "class",
    "value",
    "rev",
    "base_rev",
    "evidence"
  ],
  "unevaluatedProperties": false,
  "properties": {
    "type": {
      "const": "fact"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/opaque_id"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "class": {
      "enum": [
        "contract",
        "decision",
        "observation"
      ]
    },
    "value": {
      "type": [
        "string",
        "integer",
        "boolean",
        "object",
        "array"
      ]
    },
    "rev": {
      "description": "The revision this write creates.",
      "type": "integer",
      "minimum": 1
    },
    "base_rev": {
      "description": "The revision the writer saw; 0 for a new key.",
      "type": "integer",
      "minimum": 0
    },
    "evidence": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "common.schema.json#/$defs/hash"
      }
    },
    "check": {
      "$ref": "check.schema.json"
    }
  }
}
